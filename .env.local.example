# Google Places API Key
# Get yours at: https://console.cloud.google.com/apis/credentials
# Enable "Places API" in your Google Cloud project
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (optional, defaults to gpt-3.5-turbo)
# Examples: gpt-3.5-turbo, gpt-4, gpt-4-turbo
OPENAI_MODEL=gpt-3.5-turbo

# Set to "true" to use mock data instead of real APIs (for development/testing)
USE_MOCK_DATA=true
